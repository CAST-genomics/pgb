{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  // The app, and only the app: no node globals reach anything here, so a browser module
  // that reached for `fs` or `process` fails typecheck rather than failing in a tab. The
  // tests need the opposite and get their own project — `tsconfig.test.json`, which
  // `npm run typecheck` runs straight after this one.
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/**/__tests__/**"]
}
